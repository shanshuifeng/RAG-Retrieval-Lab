# ══════════════════════════════════════════════
#  RAG-Retrieval-Lab · .gitignore
# ══════════════════════════════════════════════
#
# ⭐ 原则：数据与索引不入库，但【实验结果必须入库】
#    因为结果的体积小（JSON），却是项目的核心产出。
# ══════════════════════════════════════════════

# ────────── 数据（体积大，可重新下载）──────────
data/raw/
data/processed/
data/index/

# ⭐ 每条 query 的完整排序结果（数十 MB，可由 _run 脚本从索引缓存重算）
results/*_run.json

# ────────── 模型缓存 ──────────
models/
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# ────────── 日志 ──────────
logs/
*.log

# ────────── Python ──────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ────────── 虚拟环境 ──────────
.venv/
venv/
env/
ENV/

# ────────── 环境变量 / 密钥（绝不入库）──────────
.env
.env.*
!.env.example

# ────────── 测试与覆盖率 ──────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ────────── Jupyter ──────────
.ipynb_checkpoints/

# ────────── 编辑器 / 系统 ──────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
# desktop.ini = Windows 资源管理器配置，非项目内容
# ⚠️ gitignore 不支持行内注释，注释必须单独成行（2026-10-24 二轮复核发现）
desktop.ini

# ────────── 临时文件 ──────────
*.tmp
*.bak
_write_probe

# ────────── 与检索实验无关的产物 ──────────
# tts_samples/：语音合成测试脚本与 mp3 样本，不属于本项目的检索实验
# （2026-10-24 经用户确认加入忽略，文件保留在本地不删除）
tts_samples/

# ══════════════════════════════════════════════
#  ⭐ 以下内容【必须入库】，不要忽略：
#
#    results/*.json          实验结果
#    results/figures/*       图表
#    configs/*.yaml          配置
#    data/DATACARD.md        数据卡片（描述数据，不是数据本身）
#    docs/*                  文档
# ══════════════════════════════════════════════

# 显式取消忽略（防止上面规则误伤）
!results/
!results/**
!configs/
!configs/**
!data/DATACARD.md

# ⭐ 但 run 文件必须【重新排除】（上面的 !results/** 会把它重新包含进来）
#    run 文件 = 每条 query 的完整排序，约 30 MB/份，可由索引缓存重算
results/*_run.json

# ⭐⭐ 例外：test 集的 run 必须入库
#    理由（2026-10-25 审查发现）：test 集已用一次性锁永久锁定，
#    既不能重跑（锁），若 run 也不入库，则「用 test 数据算其他 K 值的指标」
#    将【永久不可行】。run 文件是 test 唯一的原始证据，体积（约 150 MB）
#    换来的是「可复核性」，值得。
!results/*_test_final*_run.json
